@BOF # Beginning of File, entry into the program
$JSON #import
$Network
# spec 

# networking example
function main(): {
    JSON:{<CreateNewArray> for_each <DeviceIP>};
    JSON:{<CreateNewObject> for_each <PublicIP<Number>>};
};


# operators

+ # addition
- # subtraction
/ # division 
* # multiply 
% # modulo 
; # statement and block terminator
< # less than
> # more than
<= # less than equals
>= # more than equals
++ # iterator up
-- # iterator down
and # logical and
or # logical or
! # prefix: logical NOT

== # compare 
= # assignment 

# variables and types

$var # mutable variable declaration word
$const # constant variable declaration word

## mutable 
$var i = 1; # integer
$var K = 1.0; # float
$var N = ""; # string
$var B = true; # boolean 

## constant 
$const I = 1; # integer 
$const k = 1.0; # float
$const n = ""; # string
$const b = true; # boolean 


## optional 

$var ba = true?;

## functions

function # function declaration keywrod

function main(): {}; # main function

# structurcing 

section: RANDOM; 
end_section: RANDOM;

# construction usage 

construct: DeviceIP = {
  # logic here
};

<DeviceIP> 


construct: PublicIP = {
    construct: Number = {
        # logic here
    };
};

<PublicIP<Number>>

# parent construction

parent:  = {
    # this is how we get the JSON:{}; pattern. 
};

$var h = Enumeration.CreateNew:{};

h:{
    # fill out your enum
};

$var e = Array.CreateNew[];

e:[
    # fill out your array here
];

# for and for each


for($var Q = 1; Q <= 100; Q++): {
    if (Q % 15 == 0) {
        print("FizzBuzz");
    };
};

# for each is different, the above usage is correct but also

for_each(e; :ITEM; e++): {
  # it goes through each item in the array
};

for_each(h; :OBJECT; h++) {
    # it goes through each Object in the enum
};

# function stacking 

function IloveIt(): {
    function IReallyLoveIt(): {

    };
};

IloveIt.IReallyLoveIt;

# if statements

if (): {

} elif (): {

} else {

};

# switch

switch(): {
 case something {

 };
 case something_else {

 };

 case something_something_else {

 };

 default {

 };
};


@EOF # end of file, how you exit a program





